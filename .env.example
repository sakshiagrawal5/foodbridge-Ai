# Environment Variables for FoodBridgeAI

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Leave empty or set to 'memory' to use auto-in-memory MongoDB if local mongod is absent)
MONGODB_URI=mongodb://localhost:27017/foodbridgeai

# Security & JWT
JWT_SECRET=foodbridge_super_secret_jwt_key_2025_impact
JWT_EXPIRES_IN=1h

# Routing & Geocoding (OSRM public by default, configurable)
ROUTING_API_URL=https://router.project-osrm.org/route/v1/driving
GEOCODING_API_URL=https://nominatim.openstreetmap.org/search

# AI Features (Optional - Gemini API Key for smart suggestions & natural explanations)
GEMINI_API_KEY=

# Matching Engine Defaults
WEIGHT_URGENCY=0.35
WEIGHT_QUANTITY=0.25
WEIGHT_TRAVEL=0.25
WEIGHT_DEMAND=0.15
MAX_ACCEPTABLE_TRAVEL_MINUTES=45
DEFAULT_KG_PER_PORTION=0.45
